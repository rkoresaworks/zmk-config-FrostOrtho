#include <input/processors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/runtime-sensor-rotate.dtsi>

#define MOUSE 4

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

// AML クリックしたときにタイムアウトを延長
&mkp_input_listener { input-processors = <&zip_temp_layer MOUSE 5000>; };

/ {
    combos {
        compatible = "zmk,combos";

        combo_rctrl {
            timeout-ms = <50>;
            key-positions = <17 18>;
            bindings = <&kp RCTRL>;
        };

        combo_ralt {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp RALT>;
        };

        combo_lctrl {
            timeout-ms = <50>;
            key-positions = <11 12>;
            bindings = <&kp LCTRL>;
        };

        combo_lalt {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&kp LALT>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <1 2>;
            bindings = <&kp TAB>;
        };

        combo_space {
            timeout-ms = <50>;
            key-positions = <27 28>;
            bindings = <&kp SPACE>;
        };

        combo_gesture {
            timeout-ms = <50>;
            key-positions = <7 8>;
            bindings = <&mo 13>;
        };

        combo_bootloader {
            timeout-ms = <50>;
            key-positions = <8 24 4>;
            bindings = <&bootloader>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        screenshot: screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 7>,
                <&macro_press>,
                <&kp LEFT_WIN &kp LEFT_SHIFT &kp S>,
                <&macro_release>,
                <&kp LEFT_WIN &kp LEFT_SHIFT &kp S>;

            label = "SCREENSHOT";
        };
    };

    behaviors {
        // タップ直後に再度押し続けるとタップキーを連続入力するレイヤータップ
        lt_qt: lt_quick_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
        };
        // Kyemap Editor用
        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
        };
        vol_up_down: vol_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            bindings = <&kp C_VOL_DN>, <&kp C_VOL_UP>;
        };
        // DYA Studio用
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_DN>;
            ccw-binding = <&kp C_VOL_UP>;
        };
        rsr_scroll: rsr_scroll {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
        };
        rsr_hscroll: rsr_hscroll {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&msc SCRL_RIGHT>;
            ccw-binding = <&msc SCRL_LEFT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0_base {
            display-name = "base";
            bindings = <
&kp Q            &kp W            &kp E            &kp R            &kp T                &kp Y            &kp U            &kp I            &kp O            &kp P
&kp A            &kp S            &kp D            &kp F            &kp G                &kp H            &kp J            &kp K            &kp L            &mt RCTRL MINUS
&mt LSHIFT Z     &kp X            &kp C            &kp V            &kp B                &kp N            &kp M            &kp COMMA        &kp DOT          &mt RSHIFT FSLH
&lt 6 ESC        &kp LA(LS(F))    &kp LA(F)        &mt LGUI LANG2   &lt 1 SPACE      &lt_qt 2 BSPC        &lt 3 ENTER      &mt RGUI LANG1   &kp SPACE        &kp TAB          &mt RCTRL DEL
            >;

            sensor-bindings = <&rsr_scroll &rsr_trans>;
        };

        layer_1_number {
            display-name = "number";
            bindings = <
&kp F1     &kp F2     &kp F3     &kp F4     &trans         &trans     &kp N1     &kp N2     &kp N3     &trans
&kp F5     &kp F6     &kp F7     &kp F8     &none          &kp PLUS   &kp N4     &kp N5     &kp N6     &kp MINUS
&kp F9     &kp F10    &kp F11    &kp F12    &trans         &kp STAR   &kp N7     &kp N8     &kp N9     &kp FSLH
&trans     &trans     &trans     &trans     &trans     &trans         &trans     &kp N0     &trans     &kp DOT    &kp COMMA
            >;

            sensor-bindings = <&rsr_scroll &rsr_trans>;
        };

        layer_2_symbol {
            display-name = "symbol";
            bindings = <
&kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT      &kp CARET  &kp AMPS   &kp STAR   &kp TILDE  &kp GRAVE
&kp EQUAL  &kp LT     &kp LBKT   &kp LBRC   &kp LPAR       &kp RPAR   &kp RBRC   &kp RBKT   &kp GT     &kp PLUS
&kp UNDER  &kp PIPE   &kp SEMI   &kp COLON  &kp BSLH       &kp DQT    &kp SQT    &kp MINUS  &trans     &trans
&kp ESC    &trans     &trans     &trans     &trans     &trans         &none      &trans     &trans     &trans     &trans
            >;

            sensor-bindings = <&rsr_scroll &rsr_trans>;
        };

        layer_3_move {
            display-name = "move";
            bindings = <
&kp HOME           &kp LS(LC(TAB))    &kp PG_UP          &kp LC(TAB)        &kp END                &kp LA(N1)         &kp LA(N2)         &kp LA(N3)         &kp LA(N4)         &kp LA(N5)
&kp C_MUTE         &kp C_VOL_DN       &kp C_VOL_UP       &kp C_BRI_DN       &kp C_BRI_UP           &kp LEFT           &kp DOWN           &kp UP             &kp RIGHT          &kp LA(N0)
&kp LSHIFT         &trans             &kp PG_DN          &trans             &trans                 &kp LA(LS(LC(H)))  &kp LA(LS(LC(J)))  &kp LA(LS(LC(K)))  &kp LA(LS(LC(L)))  &kp LA(LS(B))
&trans             &trans             &trans             &trans             &trans             &trans                 &trans             &trans             &trans             &trans             &kp LG(LS(N4))
            >;

            sensor-bindings = <&rsr_hscroll &rsr_trans>;
        };

        layer_4_mouse {
            display-name = "mouse";
            bindings = <
&trans    &trans    &trans    &trans    &trans        &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans        &mkp MB1  &mkp MB2  &trans    &mo 5     &trans
&trans    &trans    &trans    &trans    &trans        &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans    &trans        &trans    &trans    &trans    &trans    &trans
            >;

            sensor-bindings = <&rsr_scroll &rsr_trans>;
        };

        layer_5_scroll {
            display-name = "scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_scroll &rsr_trans>;
        };

        layer_6_setting {
            display-name = "setting";
            bindings = <
&kp LG(LC(Q))   &trans          &trans          &trans          &trans              &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &trans
&trans          &trans          &trans          &trans          &trans              &none           &trans          &trans          &tog 12         &trans
&trans          &trans          &trans          &trans          &trans              &trans          &trans          &trans          &trans          &trans
&trans          &trans          &trans          &trans          &trans          &trans              &trans          &bootloader     &trans          &bt BT_CLR      &bt BT_CLR_ALL
            >;

            sensor-bindings = <&rsr_scroll &rsr_trans>;
        };

        layer_7_layer_7 {
            display-name = "Layer 7";
            bindings = <
&trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_scroll &rsr_trans>;
        };

        layer_8_layer_8 {
            display-name = "Layer 8";
            bindings = <
&trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_scroll &rsr_trans>;
        };

        layer_9_layer_9 {
            display-name = "Layer 9";
            bindings = <
&trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_scroll &rsr_trans>;
        };

        layer_10_layer_10 {
            display-name = "Layer 10";
            bindings = <
&trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_scroll &rsr_trans>;
        };

        layer_11_layer_11 {
            display-name = "Layer 11";
            bindings = <
&trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_scroll &rsr_trans>;
        };

        layer_12_precision {
            display-name = "Precision";
            bindings = <
&none     &none     &none     &none     &none         &none     &none     &none     &none     &none
&none     &none     &none     &none     &none         &none     &none     &mkp MB1  &mkp MB2  &mkp MB3
&none     &none     &none     &none     &none         &none     &none     &none     &none     &none
&none     &none     &none     &none     &none     &none         &none     &none     &trans    &none     &tog 12
            >;

            sensor-bindings = <&rsr_scroll &rsr_trans>;
        };

        layer_13_gesture {
            display-name = "Gesture";
            bindings = <
&none          &none          &none          &none          &none              &none          &none          &kp LC(DOWN)   &none          &none
&none          &none          &none          &none          &none              &none          &kp LC(RIGHT)  &none          &kp LC(LEFT)   &none
&none          &none          &none          &none          &none              &none          &none          &kp LC(UP)     &none          &none
&none          &none          &none          &none          &none          &none              &none          &none          &trans         &none          &none
            >;

            sensor-bindings = <&rsr_scroll &rsr_trans>;
        };
    };
};
